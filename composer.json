{
    "name": "radiusone/a2billing",
    "description": "Phone billing system based on PHP",
    "autoload": {
        "psr-4": {
            "A2billing\\": "src/"
        },
        "files": ["src/Helpers/misc.php", "src/Helpers/constants.php"]
    },
    "require": {
        "php": "^8.2",
        "amenadiel/jpgraph": "^4.0",
        "illuminate/database": "^12.0",
        "phpmailer/phpmailer": "^6.0",
        "radiusone/phpagi": "^3.0",
        "symfony/polyfill-php83": "^1.0",
        "symfony/polyfill-php84": "^1.0",
        "twbs/bootstrap": "^5.1",
        "twbs/bootstrap-icons": "^1.11",
        "ext-curl": "*",
        "ext-dom":  "*",
        "ext-gd": "*",
        "ext-gettext": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*"
    },
    "replace": {
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "license": "AGPL",
    "authors": [
        {
            "name": "Areski Belaid",
            "email": "areski@gmail.com"
        },
        {
            "name": "Michael Newton",
            "homepage": "https://github.com/radiusone/a2billing"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable" : true,
    "require-dev": {
        "dubcanada/php-profiler": "dev-master",
        "illuminate/events": "^12.0",
        "symfony/var-dumper": "^v7.0"
    }
}
